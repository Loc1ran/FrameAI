{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameai.local/contracts/live-coach.schema.json",
  "title": "LiveCoach",
  "type": "object",
  "required": [
    "sceneType",
    "subject",
    "referenceId",
    "message",
    "zoom",
    "targetZoomRatio",
    "targetX",
    "targetY",
    "isReady",
    "suggestedLutId",
    "source"
  ],
  "properties": {
    "sceneType": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape",
        "other"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "referenceId": {
      "type": "string",
      "enum": [
        "portrait_space_left",
        "portrait_space_right",
        "landscape_low_horizon",
        "landscape_high_horizon",
        "landscape_subject_small",
        "street_layer",
        "none"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "zoom": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "hold"
      ]
    },
    "targetZoomRatio": {
      "type": "number",
      "minimum": 1,
      "maximum": 8
    },
    "targetX": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "targetY": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "subjectX": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "subjectY": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "isReady": {
      "type": "boolean"
    },
    "photographyStyle": {
      "type": "string",
      "enum": ["auto", "cinematic", "portrait", "street", "landscape"]
    },
    "compositionPreset": {
      "type": "string",
      "enum": [
        "none",
        "centered",
        "negative_space_left",
        "negative_space_right",
        "low_horizon",
        "high_horizon",
        "leading_space",
        "environmental",
        "street_layer"
      ]
    },
    "primaryIssue": {
      "type": "string",
      "enum": [
        "none",
        "subject_underexposed",
        "backlit",
        "harsh_light",
        "distracting_background",
        "clipped_highlights",
        "tilted_horizon",
        "weak_separation",
        "empty_space",
        "already_strong"
      ]
    },
    "actionType": {
      "type": "string",
      "enum": [
        "hold",
        "pan_left",
        "pan_right",
        "tilt_up",
        "tilt_down",
        "straighten",
        "step_left",
        "step_right",
        "move_closer",
        "move_farther",
        "lower_camera",
        "raise_camera",
        "change_lighting",
        "expose_for_subject"
      ]
    },
    "actionReason": {
      "type": "string",
      "maxLength": 160
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
