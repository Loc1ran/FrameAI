# Copy this file to server/.env.
# Never put these in the Android app or commit server/.env.
# Leave GEMINI_API_KEY empty when using the Google Cloud login instead:
# powershell -c "iex (irm https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.ps1)"
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
DEMO_TOKEN=localtest
AI_MODE=mock
MODEL_ID=gemini-3.5-flash-lite
